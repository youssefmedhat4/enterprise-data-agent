APP_ENV=development
APP_NAME=Enterprise Data Agent
API_HOST=127.0.0.1
API_PORT=8000
API_DEBUG_PROVENANCE_ENABLED=0
OBSERVABILITY_PROVIDER=none
READINESS_REQUIRE_METRIC_PROVIDER=0
AUTHENTICATION_PROVIDER=local
LOCAL_AUTH_SUBJECT=local-developer
LOCAL_AUTH_ROLES=admin_analytics
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_DISCOVERY_URL=
OIDC_SUBJECT_CLAIM=sub
OIDC_ROLES_CLAIM=roles
OIDC_DISPLAY_NAME_CLAIM=name
OIDC_ATTRIBUTE_CLAIMS=tid,oid,preferred_username,email
OIDC_TIMEOUT_SECONDS=5
OIDC_CACHE_SECONDS=3600
OIDC_CLOCK_SKEW_SECONDS=30
AUTHORIZATION_PROVIDER=local
LOCAL_AUTHORIZATION_POLICY_PATH=infra/opa/data/local_roles.json
OPA_URL=http://localhost:8181
OPA_DECISION_PATH=/v1/data/enterprise/analytics/decision
OPA_TIMEOUT_SECONDS=3
GOVERNANCE_PROVIDER=disabled
OPENMETADATA_API_URL=http://localhost:8585/api
OPENMETADATA_JWT_TOKEN=
OPENMETADATA_FQN_PREFIX=enterprise_postgres.enterprise_analytics
OPENMETADATA_TIMEOUT_SECONDS=5
OPENMETADATA_INCLUDE_LINEAGE=1
OPENMETADATA_SENSITIVITY_CLASSIFICATIONS=PII,PersonalData,Sensitive
DATABASE_PROVIDER=fake
TOOLBOX_MCP_URL=http://localhost:5000/mcp
TOOLBOX_AUTH_TOKEN=
TOOLBOX_SOURCE_ID=enterprise-postgres
TOOLBOX_DIALECT=postgres
TOOLBOX_EXECUTE_TOOL=execute_sql
TOOLBOX_SCHEMA_TOOL=list_tables
TOOLBOX_TIMEOUT_SECONDS=15
TOOLBOX_POSTGRES_HOST=localhost
TOOLBOX_POSTGRES_PORT=5432
TOOLBOX_POSTGRES_DATABASE=enterprise_analytics
TOOLBOX_POSTGRES_USER=eda_readonly
TOOLBOX_POSTGRES_PASSWORD=
POSTGRES_ADMIN_PASSWORD=
EDA_READONLY_PASSWORD=
DATABASE_URL=postgresql://eda_readonly:${EDA_READONLY_PASSWORD}@localhost:5432/enterprise_analytics
DB_ALLOWED_SCHEMAS=analytics
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
DB_CONNECT_TIMEOUT_SECONDS=10
DB_REQUIRE_READ_ONLY=1
DB_SCHEMA_CACHE_SECONDS=300
DB_CATEGORICAL_COLUMNS=status,type,category,region
DB_SAMPLE_COLUMNS=status,type,category,region
DB_CATEGORICAL_MAX_VALUES=20
DB_CATEGORICAL_MAX_VALUE_LENGTH=64
DB_CATEGORICAL_MAX_COLUMNS=50
DB_QUERY_TIMEOUT_SECONDS=10
DB_MAX_ROWS=100
DB_MAX_RESULT_BYTES=1000000
ALLOW_CLOUD_DATABASE_DATA=0
LLM_PROVIDER=fake
LLM_MODEL_ANALYTICS_GENERAL=fake/analytics-general
LLM_MODEL_SQL_REASONER=fake/sql-reasoner
# Request-level Gemini profiles use Vertex AI and Application Default Credentials.
LLM_MODEL_GEMINI_ANALYTICS_GENERAL=vertex_ai/gemini-2.5-flash
LLM_MODEL_GEMINI_SQL_REASONER=vertex_ai/gemini-2.5-flash
LLM_GEMINI_VERTEXAI_LOCATION=global
LLM_MODEL_GEMINI_PRO_ANALYTICS_GENERAL=vertex_ai/gemini-3.1-pro-preview
LLM_MODEL_GEMINI_PRO_SQL_REASONER=vertex_ai/gemini-3.1-pro-preview
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=
LLM_REASONING_EFFORT=
CONVERSATION_CHECKPOINT_PROVIDER=memory
CHECKPOINT_DATABASE_URL=postgresql://eda_checkpoint:${CHECKPOINT_PASSWORD}@localhost:5433/enterprise_checkpoints
CHECKPOINT_PASSWORD=
CHECKPOINT_POOL_MIN_SIZE=1
CHECKPOINT_POOL_MAX_SIZE=5
CHECKPOINT_CONNECT_TIMEOUT_SECONDS=10
SEMANTIC_PROVIDER=inmemory
WREN_MCP_URL=http://localhost:8080/mcp
WREN_TIMEOUT_SECONDS=10
WREN_MAX_CONTEXT_MODELS=6
WREN_PROJECT_ID=enterprise_analytics
SQL_GENERATION_PROVIDER=llm
# Wren is the production governed-metric provider (ADR 0011, supersedes ADR 0003).
# It translates a MetricQuery to SQL only; DatabaseGateway executes it read-only.
METRIC_PROVIDER=wren
CUBE_API_URL=http://localhost:4000
CUBE_API_TOKEN=
CUBE_TIMEOUT_SECONDS=30
RUN_CLOUD_LLM_TESTS=0
RUN_LOCAL_LLM_TESTS=0
EVALUATION_REQUEST_DELAY_SECONDS=0
OLLAMA_API_BASE=http://localhost:11434
OLLAMA_NUM_CTX=8192
GEMINI_API_KEY=

# Semantic retrieval embeddings. `fake` is deterministic and offline. The
# configured Vertex model uses ADC and requires ALLOW_CLOUD_DATABASE_DATA=1.
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=gemini/gemini-embedding-2
# Changing this requires re-embedding; the stored dimension makes a
# mismatch detectable rather than silent.
EMBEDDING_DIMENSION=768
VERTEXAI_PROJECT=
VERTEXAI_LOCATION=global
GROQ_API_KEY=
CEREBRAS_API_KEY=
ZAI_API_KEY=
OPENAI_API_KEY=

# Vertex AI uses Application Default Credentials. Cloud execution is always opt-in.
# LLM_PROVIDER=litellm
# LLM_MODEL_ANALYTICS_GENERAL=vertex_ai/gemini-2.5-flash
# LLM_MODEL_SQL_REASONER=vertex_ai/gemini-2.5-flash
# VERTEXAI_PROJECT=
# VERTEXAI_LOCATION=global
# RUN_CLOUD_LLM_TESTS=1

# Optional local LiteLLM/Ollama route. Supply an installed model tag explicitly.
# LLM_PROVIDER=litellm
# LLM_MODEL_ANALYTICS_GENERAL=ollama_chat/<installed-model-tag>
# LLM_MODEL_SQL_REASONER=ollama_chat/<installed-model-tag>
# OLLAMA_API_BASE=http://localhost:11434
# OLLAMA_NUM_CTX=8192
# RUN_LOCAL_LLM_TESTS=1

# Where learned knowledge lives at runtime: postgres (production) or memory
# (development only). There is no automatic downgrade between them.
KNOWLEDGE_STORAGE=memory
QUESTION_MEMORY_ENABLED=0
QUESTION_CLUSTER_MIN_OCCURRENCES=5
QUESTION_CLUSTER_MIN_SUCCESSFUL=3
QUESTION_CLUSTER_SIMILARITY_THRESHOLD=0.82

# Gemini on Vertex AI authenticates with Application Default Credentials
# (gcloud auth application-default login). No API key is required, and ADC
# credentials never belong in this file.
# Embedding models are served from `global`; VERTEXAI_LOCATION may point at a
# region for other models, so the embedding region is configured separately.
EMBEDDING_VERTEX_LOCATION=global

# Drains the knowledge generation queue so recurring questions become
# PROPOSED candidates without admin action. Off by default: generation
# calls a model, so spending quota is an operator decision. Certification
# always stays manual.
KNOWLEDGE_WORKER_ENABLED=0
KNOWLEDGE_WORKER_POLL_SECONDS=60

# Legacy ERP demo database, used to test onboarding an unfamiliar schema.
# Start it with: docker compose --profile legacy up -d legacy-postgres
LEGACY_DATABASE_URL=
ERP_READONLY_PASSWORD=
# Reference names a reviewer may register a datasource against.
ALLOWED_CONNECTION_REFS=DATABASE_URL,LEGACY_DATABASE_URL
