  {"id":"valid_window","category":"valid","sql":"SELECT e.full_name, ROW_NUMBER() OVER (PARTITION BY e.department_id ORDER BY e.salary DESC) AS salary_rank FROM analytics.employees e","expected_valid":true},
  {"id":"valid_projection_alias_order","category":"valid","sql":"SELECT d.name AS department, SUM(e.salary) AS payroll FROM analytics.employees e JOIN analytics.departments d ON e.department_id = d.id GROUP BY d.name ORDER BY payroll DESC","expected_valid":true},
