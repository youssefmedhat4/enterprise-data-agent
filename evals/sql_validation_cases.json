  {"id":"valid_cte","category":"valid","sql":"WITH active AS (SELECT id, department_id FROM analytics.employees WHERE status = 'active') SELECT d.name, COUNT(a.id) FROM active a JOIN analytics.departments d ON a.department_id = d.id GROUP BY d.name","expected_valid":true},
